{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas://packages/contracts/atlas.card-record.v2.schema.json",
  "title": "ATLAS card record contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "card_id", "project_id", "board_id", "title", "card_type", "lifecycle", "priority", "owner", "dependencies", "board_version", "updated_at"],
  "properties": {
    "contract_version": {"type": "string", "const": "atlas.card-record.v2"},
    "card_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "board_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "card_type": {"type": "string", "enum": ["feature", "bug", "governance", "architecture", "documentation", "automation", "research", "migration", "reliability", "technical-debt"]},
    "lifecycle": {"type": "string", "enum": ["intake", "planning", "ready", "in-progress", "review", "completed", "archived", "blocked"]},
    "priority": {"type": ["string", "null"], "enum": ["critical", "high", "medium", "low", null]},
    "owner": {"type": ["string", "null"]},
    "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "board_version": {"type": "integer", "minimum": 0},
    "updated_at": {"type": "string", "format": "date-time"},
    "source_ref": {"type": ["string", "null"]},
    "extensions": {"type": "object"}
  }
}
